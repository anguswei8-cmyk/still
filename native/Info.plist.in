<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
<key>CFBundleIdentifier</key><string>local.still.app</string>
<key>CFBundleName</key><string>Still</string>
<key>CFBundleIconFile</key><string>still.icns</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>${PROJECT_VERSION}</string>
<key>CFBundleVersion</key><string>${PROJECT_VERSION}</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSScreenCaptureUsageDescription</key><string>Still needs screen recording access to capture your screen. Images stay on this device.</string>
</dict></plist>
